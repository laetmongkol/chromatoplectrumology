{
  "name": "chromatoplectrumology",
  "description": "Practice guitar in the browser: audio interface input, live effects, scale practice with scoring, tuner. Fully translatable from a database.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:seed": "node --experimental-strip-types --env-file=.env.local scripts/seed.mts",
    "make-admin": "node --experimental-strip-types --env-file=.env.local scripts/make-admin.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.17",
    "drizzle-orm": "^0.45.4",
    "flag-icons": "^7.6.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
